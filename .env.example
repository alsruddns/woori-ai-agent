WOORI_BASE_URL=https://www.woori.today
MAX_PAGES=50
REQUEST_DELAY_MS=1000
PAID_AI_API_ENABLED=false
AI_API_BUDGET_USD=0
AI_AUTO_EXECUTION=false
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CREDENTIALS_DPAPI_FILE=data/google-credentials.dpapi
GOOGLE_LOCAL_OAUTH_FILE=data/google-oauth.dpapi
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GSC_SITE_URL=
GSC_API_ENABLED=false
GA4_PROPERTY_ID=
GA4_API_ENABLED=false
GA4_ZERO_COST_CONFIRMED=false
GOOGLE_CLOUD_BILLING_DISABLED=false
ADSENSE_ACCOUNT_ID=
ADSENSE_API_ENABLED=false
ADSENSE_ZERO_COST_CONFIRMED=false
ANALYTICS_START_DATE=
ANALYTICS_END_DATE=
REPORT_RETENTION_DAYS=90
WOORI_CONTROLLER_DB_PATH=data/controller/queue.sqlite
WOORI_CONTROLLER_HOST=127.0.0.1
WOORI_CONTROLLER_PORT=4180
WOORI_SCHEDULER_ENABLED=false
WOORI_WORKER_OFFLINE_AFTER_MS=45000
WOORI_CONTROLLER_PRIVATE_NETWORK=false
WOORI_CONTROLLER_TLS_KEY_FILE=
WOORI_CONTROLLER_TLS_CERT_FILE=
# Configure secrets locally; never commit real tokens. Remote use requires private IP + TLS.
WOORI_CONTROLLER_WORKER_ID=
WOORI_CONTROLLER_HOST_LABEL=
WOORI_CONTROLLER_WORKER_TOKEN=
WOORI_CONTROLLER_URL=http://127.0.0.1:4180
# Controller-side JSON map, for example with locally provisioned worker IDs and random tokens.
WOORI_CONTROLLER_WORKER_TOKENS=
# Controller-trusted policy; never let a Worker request body grant itself capabilities.
WOORI_CONTROLLER_WORKER_POLICIES=
