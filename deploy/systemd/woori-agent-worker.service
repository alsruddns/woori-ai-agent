[Unit]
Description=Woori AI Agent restricted read-only Worker heartbeat
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=3

[Service]
Type=simple
User=woori-agent-worker
Group=woori-agent-worker
Slice=woori-agent-worker.slice
WorkingDirectory=/opt/woori-ai-agent/current
EnvironmentFile=/etc/woori-ai-agent/worker.env
ExecStart=/opt/woori-ai-agent/current/node_modules/.bin/tsx apps/cli/src/index.ts worker heartbeat-loop --interval-seconds=30
Restart=on-failure
RestartSec=20s
TimeoutStopSec=20s
KillMode=control-group
TasksMax=32
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/woori-ai-agent-worker
StateDirectory=woori-ai-agent-worker
StateDirectoryMode=0700
LogsDirectory=woori-ai-agent
UMask=0077
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
