[Unit]
Description=Woori AI Agent bounded read-only Scheduler
ConditionPathExists=/etc/woori-ai-agent/scheduler.enabled
After=network-online.target woori-agent-controller.service
Wants=network-online.target
Requires=woori-agent-controller.service
StartLimitIntervalSec=10min
StartLimitBurst=3

[Service]
Type=simple
User=woori-agent
Group=woori-agent
Slice=woori-agent-controller.slice
WorkingDirectory=/opt/woori-ai-agent/current
EnvironmentFile=/etc/woori-ai-agent/scheduler.env
ExecStart=/opt/woori-ai-agent/current/node_modules/.bin/tsx apps/cli/src/index.ts scheduler daemon
Restart=on-failure
RestartSec=20s
TimeoutStopSec=30s
KillMode=control-group
TasksMax=48
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/woori-ai-agent /var/log/woori-ai-agent
StateDirectory=woori-ai-agent
StateDirectoryMode=0700
LogsDirectory=woori-ai-agent
LogsDirectoryMode=0700
UMask=0077
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
