{
  "name": "woori-ai-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Local and GitHub Actions website intelligence for woori.today",
  "packageManager": "pnpm@9.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "agent": "tsx apps/cli/src/index.ts",
    "agent:discover": "pnpm agent discover",
    "agent:all": "pnpm agent all",
    "agent:qa": "pnpm agent qa",
    "agent:seo": "pnpm agent seo",
    "agent:content": "pnpm agent content",
    "agent:competitor": "pnpm agent competitor",
    "agent:growth": "pnpm agent growth",
    "agent:ux": "pnpm agent ux",
    "agent:performance": "pnpm agent performance",
    "agent:i18n": "pnpm agent localization",
    "agent:ads": "pnpm agent ads",
    "agent:change": "pnpm agent change",
    "agent:analytics": "pnpm agent analytics",
    "agent:gsc": "pnpm agent gsc run",
    "agent:gsc:properties": "pnpm agent gsc properties",
    "agent:google:connect": "tsx apps/cli/src/google-auth.ts",
    "agent:improvement": "pnpm agent improvement",
    "agent:report": "pnpm agent report",
    "agent:repro:calculators": "node scripts/repro-calculators.mjs",
    "agent:explore": "tsx apps/cli/src/index.ts explore",
    "agent:api": "tsx apps/cli/src/server.ts",
    "agent:dashboard": "concurrently -k -s first \"pnpm agent:api\" \"pnpm --dir apps/dashboard dev\"",
    "test": "vitest run",
    "lint": "eslint apps/cli/src apps/dashboard/src tests eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "build": "pnpm --dir apps/dashboard build",
    "agent:adsense-approval": "pnpm agent adsense-approval",
    "agent:development": "pnpm agent development status"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.14.0",
    "better-sqlite3": "^11.7.0",
    "cheerio": "^1.0.0",
    "chrome-launcher": "^1.2.2",
    "lighthouse": "^12.8.2",
    "playwright": "^1.49.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
