    { "id": "daily-localization-content", "intervalHours": 24, "action": "localization-content", "services": ["home", "calculator", "tools", "docs", "quiz"], "maxPages": 10, "browser": false },
    { "id": "weekly-regression-summary", "intervalHours": 168, "action": "weekly-regression-summary", "services": ["home", "calculator", "tools", "docs", "quiz"], "maxPages": 0, "browser": false }
